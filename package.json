{
  "name": "task-manager-react",
  "version": "1.0.0",
  "description": "智能任务管理系统（Node.js + Express 后端 + React 前端 + Supabase）",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"node server/index.js\" \"vite\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "vite": "^5.4.8"
  }
}
